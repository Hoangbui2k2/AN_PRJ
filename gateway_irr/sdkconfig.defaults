#
# ESP32 LoRa-to-MQTT Gateway - SDK Configuration Defaults
#

# === WiFi Configuration ===
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_CSI_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_MBO_ENABLED=n
CONFIG_ESP_WIFI_FTM_ENABLED=n

# Enable WiFi station mode only (save memory)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Enable WPA2 security
CONFIG_ESP_WIFI_WPA2_ENT_SUPPORT=n
CONFIG_ESP_WIFI_WAPI_SUPPORT=n
CONFIG_ESP_WIFI_OWE_SUPPORT=n
CONFIG_ESP_WIFI_SAE_SUPPORT=n

# === MQTT Configuration ===
# Use custom partition table (partitions.csv) to add a dedicated `certs` NVS
# partition for the X.509 certificate / private key / CA.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSECURE=n
CONFIG_MQTT_MSG_ID_INCREMENTAL=y
CONFIG_MQTT_SKIP_PUBLISH_IF_DISCONNECTED=y
CONFIG_MQTT_REPORT_DELETED_MESSAGES=n
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_TASK_CORE_0=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=30000
CONFIG_MQTT_BUFFER_SIZE=1024

# === FreeRTOS Configuration ===
CONFIG_FREERTOS_HZ=100
CONFIG_FREERTOS_NUMBER_OF_CORES=2
CONFIG_FREERTOS_TASK_FUNCTION_WRAPPER=y

# === UART/Driver Configuration ===
CONFIG_UART_ISR_IN_IRAM=n

# === Logging Configuration ===
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y
CONFIG_LOG_BOOTLOADER_LEVEL=2

# === NVS Configuration ===
CONFIG_NVS_ENCRYPTION=n

# === LWIP Configuration ===
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=n
CONFIG_LWIP_DNS_MAX_SERVERS=2
CONFIG_LWIP_AUTOIP=n
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_IPV6=n

# === Compiler Options ===
CONFIG_OPTIMIZATION_LEVEL_RELEASE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=n

# === Power Management ===
CONFIG_PM_ENABLE=n

# === ESP Timer Configuration ===
CONFIG_ESP_TIMER_PROFILING=n
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3584

# === Main Task ===
CONFIG_MAIN_TASK_STACK_SIZE=4096

# === ESP System ===
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_CORE_0=y
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK=n
CONFIG_ESP_ERR_TO_NAME_LOOKUP=y

# === Crash diagnostics ===
# Keep the chip alive after a panic so the full Guru Meditation message and
# backtrace are printed before the reboot (with 0 the reset truncates the
# message and the serial line goes floating -> only garbage in the log).
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=3
# Raise the brownout threshold so a supply sag caused by the LoRa module's RF
# burst produces a clean brownout reset ("Brownout detector was triggered")
# instead of letting the CPU run out of spec and execute garbage. Lower it back
# to 0 once the power path is verified. Levels: 0=2.43 V .. 7=2.78 V.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

# === Heap Configuration ===
CONFIG_HEAP_TRACING=n
CONFIG_HEAP_POISONING_DISABLED=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# === Ethernet (disabled) ===
CONFIG_ETH_ENABLED=n
